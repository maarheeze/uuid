{
    "name": "maarheeze/uuid",
    "description": "simple uuid value object",
    "type": "library",
    "license": "MIT",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Maarheeze\\Uuid\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.4",
        "ramsey/uuid": "^4.9"
    },
    "require-dev": {
        "maarheeze/phpcs": "^2.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13"
    },
    "suggest": {
        "maarheeze/uuid-laravel": "Eloquent cast and primary key support for Laravel models",
        "maarheeze/uuid-livewire": "Keeps typed uuids as Livewire component properties across requests",
        "maarheeze/uuid-symfony": "Serializer normalizer for typed uuids in Symfony"
    }
}
